#!/usr/bin/env python
"""migrate-rules — 把旧版合卷 persona/iron-card.md 拆成 rules/<slug>.md，一条一卡。

用法：migrate-rules [--slugs a,b,c] [--json]

  - 合卷里每个编号条目（`1. **标题**：正文`，续行缩进）成为一张规则卡；
    标题取加粗部分，摘要取正文首行，正文保留原文（续行去缩进）。
  - --slugs 按条目顺序给出卡片 slug，数量必须与条目数一致；缺省为 rule-1、rule-2…
  - 全部卡片先校验再写入：任一 slug 非法、重复或目标卡已存在 → 零写入。
  - 写完删除合卷、记一条 journal decision 并重编译 context.md。
  - 没有合卷时什么都不做（幂等）。
退出码：0 成功；1 执行失败；2 用法错误。
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _legacy_guard import LegacyWriteBlocked, assert_legacy_write_allowed
from _lib import (BUTLER_ROOT, JOURNAL_FILE, JOURNAL_LOCK, LEGACY_IRON_FILE, PROPOSALS_LOCK,  # noqa: E402
                  RULES_DIR, SLUG_RE, append_jsonl, atomic_write, compile_context,
                  ensure_dirs, file_lock, render_card, utc_now)

ITEM = re.compile(r"^(\d+)\.\s+(.*)$")
TITLED = re.compile(r"^\*\*(.+?)\*\*\s*[：:]\s*(.*)$", re.S)


def parse_items(text: str) -> list[dict]:
    """编号条目 → [{title, body}]；条目之外的标题/引言不迁移。"""
    items, current = [], None
    for line in text.splitlines():
        m = ITEM.match(line)
        if m:
            current = [m.group(2)]
            items.append(current)
        elif current is not None and line.startswith((" ", "\t")) and line.strip():
            current.append(line.strip())
        elif not line.strip():
            current = None
    out = []
    for lines in items:
        text = "\n".join(lines)
        m = TITLED.match(text)
        title, body = (m.group(1).strip(), m.group(2).strip()) if m else (lines[0][:40], text)
        out.append({"title": title, "body": body})
    return out


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="migrate-rules")
    ap.add_argument("--slugs", default="")
    ap.add_argument("--json", action="store_true")
    try:
        args = ap.parse_args(argv)
    except SystemExit as exc:
        return 2 if exc.code else 0

    def done(result: dict) -> int:
        print(json.dumps(result, ensure_ascii=False) if args.json
              else (f"已迁移 {len(result['migrated'])} 张规则卡" if result["migrated"] else "没有需要迁移的合卷"))
        return 0

    if not LEGACY_IRON_FILE.exists():
        return done({"migrated": []})
    items = parse_items(LEGACY_IRON_FILE.read_text(encoding="utf-8"))
    slugs = [s.strip() for s in args.slugs.split(",") if s.strip()] or [f"rule-{i + 1}" for i in range(len(items))]
    if not items:
        print("migrate-rules: 合卷里没有编号条目，未做任何改动", file=sys.stderr)
        return 1
    if len(slugs) != len(items):
        print(f"migrate-rules: 合卷有 {len(items)} 条，--slugs 给了 {len(slugs)} 个", file=sys.stderr)
        return 2
    bad = [s for s in slugs if not SLUG_RE.match(s)]
    if bad or len(set(slugs)) != len(slugs):
        print(f"migrate-rules: slug 非法或重复：{', '.join(bad) or '重复'}", file=sys.stderr)
        return 2
    try:
        assert_legacy_write_allowed(BUTLER_ROOT)
    except LegacyWriteBlocked as error:
        print(f"migrate-rules: {error}", file=sys.stderr)
        return 1
    ensure_dirs()
    with file_lock(PROPOSALS_LOCK):
        taken = [s for s in slugs if (RULES_DIR / f"{s}.md").exists()]
        if taken:
            print(f"migrate-rules: 规则卡已存在：{', '.join(taken)}，未做任何改动", file=sys.stderr)
            return 1
        now = utc_now()
        for slug, item in zip(slugs, items):
            atomic_write(RULES_DIR / f"{slug}.md", render_card(item["title"], item["body"], approved_at=now))
        ids = [f"rule/{s}" for s in slugs]
        with file_lock(JOURNAL_LOCK):
            append_jsonl(JOURNAL_FILE, [{"ts": now, "source": "butler", "type": "decision", "tags": ["migrate-rules"],
                                         "text": f"旧版合卷 {LEGACY_IRON_FILE.name} 拆为 {len(ids)} 张规则卡：{', '.join(ids)}"[:2000]}])
        LEGACY_IRON_FILE.unlink()
    try:
        compile_context()
    except (OSError, ValueError) as error:
        print(f"migrate-rules: 已迁移，但 context.md 编译失败：{error}", file=sys.stderr)
    return done({"migrated": ids})


if __name__ == "__main__":
    sys.exit(main())
